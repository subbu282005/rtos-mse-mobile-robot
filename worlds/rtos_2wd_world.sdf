<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rtos_2wd_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four perimeter walls: 10 m x 10 m enclosure -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>10 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.15 1</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>10 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.15 1</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.15 10 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 1</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.15 10 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10 1</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Internal obstacles -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.5 1.4 0.35 0 0 0.2</pose>
      <link name="obstacle">
        <collision name="collision"><geometry><box><size>0.9 0.8 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 0.8 0.7</size></box></geometry><material><ambient>0.8 0.25 0.15 1</ambient><diffuse>0.8 0.25 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>-1.5 1.5 0.3 0 0 0</pose>
      <link name="obstacle">
        <collision name="collision"><geometry><box><size>0.7 0.7 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 0.6</size></box></geometry><material><ambient>0.2 0.65 0.25 1</ambient><diffuse>0.2 0.65 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>1.6 -1.6 0.3 0 0 0</pose>
      <link name="obstacle">
        <collision name="collision"><geometry><box><size>0.7 1.0 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 1.0 0.6</size></box></geometry><material><ambient>0.2 0.35 0.8 1</ambient><diffuse>0.2 0.35 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_4">
      <static>true</static>
      <pose>-1.7 -1.5 0.25 0 0 -0.25</pose>
      <link name="obstacle">
        <collision name="collision"><geometry><box><size>1.0 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.5 0.5</size></box></geometry><material><ambient>0.8 0.65 0.15 1</ambient><diffuse>0.8 0.65 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Two-wheel differential-drive robot -->
    <model name="rtos_2wd_robot">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <pose>0 0 0.16 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.012</ixx><iyy>0.020</iyy><izz>0.025</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <geometry><box><size>0.32 0.24 0.08</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <geometry><box><size>0.32 0.24 0.08</size></box></geometry>
          <material>
            <ambient>0.1 0.25 0.8 1</ambient>
            <diffuse>0.1 0.25 0.8 1</diffuse>
          </material>
        </visual>

        <!-- 2D LiDAR -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.12 0 0.12 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Wheels: centres are 0.13 m either side of the chassis.
           The 0.05 m wheel width overlaps the chassis sides slightly. -->
      <link name="left_wheel">
        <pose>0 0.13 0.08 1.5707963 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.13 0.08 1.5707963 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <pose relative_to="base_link">0 0.13 -0.08 0 0 0</pose>
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis><xyz>0 1 0</xyz><limit><effort>10</effort><velocity>30</velocity></limit></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <pose relative_to="base_link">0 -0.13 -0.08 0 0 0</pose>
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis><xyz>0 1 0</xyz><limit><effort>10</effort><velocity>30</velocity></limit></axis>
      </joint>

      <!-- Passive support casters prevent forward/backward tipping -->
      <link name="front_caster">
        <pose>0.12 0 0.03 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><sphere><radius>0.03</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.03</radius></sphere></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
      <joint name="front_caster_joint" type="fixed">
        <parent>base_link</parent><child>front_caster</child>
      </joint>

      <link name="rear_caster">
        <pose>-0.12 0 0.03 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision"><geometry><sphere><radius>0.03</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.03</radius></sphere></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
      <joint name="rear_caster_joint" type="fixed">
        <parent>base_link</parent><child>rear_caster</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.26</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>
